{
  "name": "snapshot-service",
  "version": "0.1.0",
  "private": true,
  "description": "Daily snapshot API feeding the printer add-on.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:once": "tsx src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "fmt": "prettier --check .",
    "fmt:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "npm run lint && npm run fmt && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
