{
  "name": "sonos-api",
  "version": "1.0.0",
  "description": "Sonos HTTP API proxy for node-sonos-http-api",
  "main": "src/server/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "start:dev": "tsx src/server/index.ts",
    "test": "tsx src/server/intents.spec.ts && tsx src/server/status-proxy.spec.ts && tsx src/server/graceful-shutdown.spec.ts",
    "stop": "pkill -f sonos-api-server",
    "dev": "supervisor -p 200 -RV -x npm -- run start:dev"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "supervisor": "^0.12.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
