{
	# Only this container can reach the certificate-reload socket.
	admin unix//run/caddy-private/admin.sock
	auto_https off
	persist_config off
	# Request URLs can contain media credentials. No access logging; suppress
	# HTTP error request dumps while retaining startup/configuration diagnostics.
	log default {
		exclude http.log.error
	}
}

(arr_gate) {
	request_header -Authorization
	request_header -Proxy-Authorization
	request_header -Forwarded
	request_header -X-Forwarded-*
	request_header -X-Real-IP
	request_header -Remote-*
	request_header -X-Remote-*
	request_header -X-Auth-*
	forward_auth http://127.0.0.1:9091 {
		uri /api/authz/forward-auth
	}
}

(arr_upstream) {
	header_up Authorization {env.SMARTHOME_ARR_AUTH}
	header_up -Proxy-Authorization
	header_up -Remote-*
	header_up -X-Auth-*
}

http://:80 {
	bind 192.168.1.163
	@outside not remote_ip 192.168.1.0/24
	handle @outside {
		respond "LAN access only" 403
	}
	@auth host auth.home.arpa auth.apps.home.arpa auth.home.rytim.com
	handle @auth {
		redir https://auth.home.rytim.com{uri} 308
	}
	@dashboard host grid-dashboard.home.arpa
	handle @dashboard {
		reverse_proxy http://hass.home.arpa:3000
	}
	@git host git.home.arpa git.home.rytim.com
	handle @git {
		redir https://git.home.rytim.com{uri} 308
	}
	@jellyfin host jellyfin.home.arpa
	handle @jellyfin {
		reverse_proxy http://192.168.1.66:8096
	}
	@moonfin host moonfin.home.arpa
	handle @moonfin {
		redir / /Moonfin/Web/ 302
		reverse_proxy http://192.168.1.66:8096
	}
	@plex host plex.home.arpa
	handle @plex {
		redir / /web/ 302
		reverse_proxy http://192.168.1.66:32400
	}
	@seerr host seerr.home.arpa
	handle @seerr {
		reverse_proxy http://10.77.0.1:15055 {
			# The private gateway matches its existing numeric Host.
			header_up Host 10.77.0.1:15055
		}
	}
	@sabnzbd host sabnzbd.home.arpa sabnzbd.home.rytim.com
	handle @sabnzbd {
		redir https://sabnzbd.home.rytim.com{uri} 308
	}
	@catalog host catalog.home.arpa catalog.home.rytim.com
	handle @catalog {
		redir https://catalog.home.rytim.com{uri} 308
	}
	@printer host printer.home.arpa
	handle @printer {
		reverse_proxy http://hass.home.arpa:8099
	}
	@tinyurl host tinyurl.home.arpa
	handle @tinyurl {
		reverse_proxy http://hass.home.arpa:4100
	}
	@radarr host radarr.home.arpa radarr.home.rytim.com
	handle @radarr {
		redir https://radarr.home.rytim.com{uri} 308
	}
	@sonarr host sonarr.home.arpa sonarr.home.rytim.com
	handle @sonarr {
		redir https://sonarr.home.rytim.com{uri} 308
	}
	@prowlarr host prowlarr.home.arpa prowlarr.home.rytim.com
	handle @prowlarr {
		redir https://prowlarr.home.rytim.com{uri} 308
	}
	handle {
		respond "Unknown service" 404
	}
}

https://auth.home.rytim.com {
	bind 192.168.1.163
	tls /ssl/smarthome/acme/current/fullchain.pem /ssl/smarthome/acme/current/key.pem
	@outside not remote_ip 192.168.1.0/24
	handle @outside {
		respond "LAN access only" 403
	}
	handle {
		reverse_proxy http://127.0.0.1:9091
	}
}

https://git.home.rytim.com {
	bind 192.168.1.163
	tls /ssl/smarthome/acme/current/fullchain.pem /ssl/smarthome/acme/current/key.pem
	@outside not remote_ip 192.168.1.0/24
	handle @outside {
		respond "LAN access only" 403
	}
	handle {
		reverse_proxy http://192.168.1.66:3003
	}
}

https://radarr.home.rytim.com {
	bind 192.168.1.163
	tls /ssl/smarthome/acme/current/fullchain.pem /ssl/smarthome/acme/current/key.pem
	@outside not remote_ip 192.168.1.0/24
	handle @outside {
		respond "LAN access only" 403
	}
	handle {
		route {
			import arr_gate
			redir / /radarr/ 302
			@allowed path /radarr /radarr/*
			handle @allowed {
				reverse_proxy http://10.77.0.1:19696 {
					import arr_upstream
				}
			}
			handle {
				respond "Unknown service path" 404
			}
		}
	}
}

