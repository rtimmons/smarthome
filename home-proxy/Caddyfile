# Native Jellyfin clients authenticate directly against Jellyfin's AD provider.
# A browser redirect gate here would break TV/mobile playback and API clients.
https://jellyfin.home.rytim.com {
	bind 192.168.1.163
	tls /ssl/smarthome/acme/current/fullchain.pem /ssl/smarthome/acme/current/key.pem
	@outside not remote_ip 192.168.1.0/24
	handle @outside {
		respond "LAN access only" 403
	}
	handle {
		reverse_proxy http://192.168.1.66:8096
	}
}
