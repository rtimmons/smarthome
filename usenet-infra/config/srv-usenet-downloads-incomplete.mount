[Unit]
Description=Bind the dedicated repair volume at the SAB incomplete path
Requires=srv-usenet-downloads-complete-remote.mount srv-usenet-repair.mount
BindsTo=srv-usenet-downloads-complete-remote.mount srv-usenet-repair.mount
After=srv-usenet-downloads-complete-remote.mount srv-usenet-repair.mount

[Mount]
What=/srv/usenet/repair/incomplete
Where=/srv/usenet/downloads/incomplete
Type=none
Options=bind,_netdev
TimeoutSec=30

[Install]
WantedBy=multi-user.target srv-usenet-downloads-complete-remote.mount
