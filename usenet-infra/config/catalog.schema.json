{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/usenet-infra/catalog.schema.json",
  "title": "Canonical catalog item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "source",
    "authorization",
    "acquired_at",
    "remote_path",
    "size_bytes",
    "files",
    "integrity",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["video", "audio", "books", "software", "archives", "other"]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["description"],
      "properties": { "description": { "type": "string", "minLength": 1 } }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": true,
      "required": ["basis"],
      "properties": { "basis": { "type": "string", "minLength": 1 } }
    },
    "acquired_at": { "type": "string", "format": "date-time" },
    "remote_path": { "type": "string", "pattern": "^objects/[^/]+/[^/]+$" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "verified_at"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "verified_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "notes": { "type": "string" }
  }
}
