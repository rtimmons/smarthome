# Use as the controller-side defaults source. Ansible installs it as
# /srv/usenet/config/catalog.env.defaults and renders the live catalog.env with
# API keys generated by SABnzbd and Prowlarr. Never commit the rendered file.
CATALOG_ROLE=cloud
CATALOG_REMOTE=storagebox:catalog
CATALOG_PROMOTION_ROOT=/srv/usenet/downloads/complete
CATALOG_LOCAL_ROOT=/srv/usenet/local-cache-unused
CATALOG_STATE_ROOT=/srv/usenet/state/catalog
CATALOG_STAGING_ROOT=/srv/usenet/state/staging
RCLONE_CONFIG=/srv/usenet/config/rclone/rclone.conf
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=4
SCRATCH_MIN_FREE_BYTES=32212254720
STORAGE_WARN_FRACTION=0.80
SABNZBD_URL=http://127.0.0.1:8080
SABNZBD_API_KEY=
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=
