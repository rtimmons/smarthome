# Cache the exact verified age binaries for this workstation and cloud VM.
[group: 'setup']
age-bootstrap:
	@python3 scripts/bootstrap-age.py

# Cache the reviewed native-age and SOPS recovery tools without creating a key.
[group: 'setup']
crypto-bootstrap: age-bootstrap
	@python3 scripts/bootstrap-sops.py

# Record the public recipient from the one-process SOPS_AGE_KEY value. The key
# is written only to a private temporary file while age-keygen derives `age1…`.
[group: 'recovery']
[positional-arguments]
recovery-master-init confirmation: crypto-bootstrap
	#!/usr/bin/env bash
	set -euo pipefail
	if [[ "$1" != "second-copy-planned" ]]; then
	  echo "confirmation must be the literal: second-copy-planned" >&2
	  exit 2
	fi
	exec python3 scripts/recovery-master-init.py --confirm-second-copy

# Restore all allowlisted local inputs from the committed SOPS ciphertext.
# Supply SOPS_AGE_KEY in the calling environment; it is never a recipe argument.
[group: 'recovery']
[positional-arguments]
setup-secrets *args: crypto-bootstrap
	#!/usr/bin/env bash
	set -euo pipefail
	exec python3 scripts/secrets-vault.py restore "$@"

# Replace the committed ciphertext from the current allowlisted local inputs.
# The same one-process SOPS identity input is required to verify the result.
[group: 'recovery']
[positional-arguments]
secrets-encrypt *args: crypto-bootstrap
	#!/usr/bin/env bash
	set -euo pipefail
	exec python3 scripts/secrets-vault.py encrypt "$@"

