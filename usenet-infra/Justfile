[private]
_deploy-seerr-recovery:
	#!/usr/bin/env bash
	set -euo pipefail
	source ../talos/scripts/nvm_use.sh
	just --justfile ../new-hass-configs/Justfile --working-directory ../new-hass-configs home-assistant-build
	python3 scripts/seerr-recovery-ha.py
	cd ansible
	{{ansible}} ansible-playbook seerr-recovery.yml

