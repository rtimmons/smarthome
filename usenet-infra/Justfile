# Run all checks that do not require live infrastructure.
[group: 'validation']
test: ansible-setup
	@just --justfile ../Justfile --working-directory .. wiki-check
	python3 -m unittest discover -s tests -v
	python3 scripts/secrets-check.py --manifest-only
	python3 -m compileall -q scripts
	shellcheck scripts/recovery-run
	shellcheck scripts/backup-qnap
	python3 -c 'import json; json.load(open("config/catalog.schema.json")); json.load(open("config/examples/catalog-item.json"))'
	shellcheck compose/qnap/catalog-run scripts/catalog-list scripts/catalog-status scripts/catalog-pull scripts/catalog-evict scripts/healthcheck scripts/qnap-command scripts/cloud-command scripts/cloud-ui scripts/filex-ui scripts/config-backup-local scripts/backup-cloud scripts/secret-scan scripts/store-hcloud-token scripts/generate-ssh-keys scripts/prepare-terraform-vars scripts/terraform-with-token
	@python3 -c 'from pathlib import Path; import yaml; [list(yaml.compose_all(p.read_text())) for root in ("ansible", "compose") for p in Path(root).rglob("*") if p.suffix in (".yml", ".yaml") and p.is_file() and not p.is_symlink() and ".collections" not in p.parts]'
	cd ansible && {{ansible}} ansible-playbook -i inventory.example.yml --syntax-check \
	    site.yml backup.yml cloud-lan-ui.yml cloud-sso.yml discovery.yml \
	    dashboard-refresh.yml scheduled-backups.yml qnap-backups.yml cloud-library.yml \
	    qnap-remote-media.yml native-cutover.yml filex.yml seerr.yml \
	    seerr-recovery.yml seerr-sync.yml seerr-safety.yml cleanuparr-replay.yml \
	    filex-backups.yml restore-storage.yml qnap-wiki.yml
	cd ansible && {{ansible}} ansible-playbook -i inventory.example.yml sab-buffered.yml -e sab_buffered_action=build --syntax-check
	shellcheck config/arr-shared-library-init
	./scripts/secret-scan

