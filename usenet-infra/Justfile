# Isolated NAS Active Directory; uses dedicated NAS access and external secrets.
[group: 'identity']
[positional-arguments]
identity *args:
	#!/usr/bin/env bash
	set -euo pipefail
	cd ..
	export UV_PROJECT_ENVIRONMENT="$PWD/build/wiki/venv"
	exec uv run --project wiki --python "$(cat .python-version)" --frozen python identity-infra/manage.py "$@"

