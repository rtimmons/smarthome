http://10.77.0.1:15055 {
	bind 10.77.0.1
	# Seerr owns Plex login and its session. API keys remain loopback-only.
	@api_key header X-API-Key *
	respond @api_key 403
	reverse_proxy 127.0.0.1:5055 {
		header_up -X-API-User
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up -X-Real-IP
		header_up Host 10.77.0.1:15055
	}
}
