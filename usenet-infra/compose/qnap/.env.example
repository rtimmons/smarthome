# Copy this file to .env beside compose.yaml. The values below are examples,
# not working credentials. Never place a password or private-key content here.

# Numeric identity for container processes; no supplementary admin groups.
# The SSH deployment account is separate and may require QNAP administrator membership.
QNAP_UID=REPLACE_WITH_NUMERIC_UID
QNAP_GID=REPLACE_WITH_NUMERIC_GID

# Use stable shared-folder paths. Do not use CACHEDEV*, ZFS*, or .qpkg paths.
QNAP_CATALOG_CACHE_DIR=/share/REPLACE_WITH_LOCAL_LIBRARY/usenet-cache
QNAP_CATALOG_STATE_DIR=/share/Container/usenet/state
# This is the `usenet-infra/scripts` directory in the checked-out repository.
# The catalog container mounts it read-only.
QNAP_CATALOG_SCRIPTS_DIR=/share/Container/usenet/repository/usenet-infra/scripts
QNAP_STORAGEBOX_KEY_FILE=/share/Container/usenet/secrets/storagebox/id_ed25519
QNAP_STORAGEBOX_KNOWN_HOSTS_FILE=/share/Container/usenet/secrets/storagebox/known_hosts

# Use the read-only Storage Box subaccount, never the ingestion account.
STORAGEBOX_HOST=uXXXXX-subX.your-storagebox.de
STORAGEBOX_USER=uXXXXX-subX
STORAGEBOX_PORT=23

# Port 23's restricted shell normally supplies sha256sum. Confirm this with the
# actual read-only subaccount before relying on remote checksum reporting.
STORAGEBOX_SHELL_TYPE=unix
STORAGEBOX_HASHES=sha256
STORAGEBOX_SHA256SUM_COMMAND=sha256sum

# Keep conservative defaults until a representative large-file test succeeds.
RCLONE_SFTP_CHUNK_SIZE=32Ki
RCLONE_SFTP_CONCURRENCY=64
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=4

# Leave this much free space after a pull. Default: 10 GiB.
CATALOG_MIN_FREE_BYTES=10737418240
# Warn when the remote reports at least this fraction used.
STORAGE_WARN_FRACTION=0.80
TZ=America/New_York

# Deliberately approve a stable NAS LAN IP, or use 127.0.0.1 through an SSH tunnel.
# Never bind 0.0.0.0 and never forward this port through the router.
QNAP_DASHBOARD_BIND_ADDRESS=127.0.0.1
QNAP_DASHBOARD_PORT=1337
QNAP_DASHBOARD_CONFIG_DIR=/share/Container/usenet/compose/qnap/olivetin
QNAP_DASHBOARD_STATE_DIR=/share/Container/usenet/state/dashboard
QNAP_DASHBOARD_AUTH_FILE=/share/Container/usenet/secrets/dashboard-auth.json
CATALOG_DASHBOARD_REFRESH_SECONDS=60
