#!/bin/sh
set -eu

tool="${1:-healthcheck}"
if [ "$tool" = --self-test ]; then
    [ "$#" -eq 1 ] || exit 64
    python3 -c 'import os; assert os.getuid() > 0 and os.getgid() > 0, "Catalog must run without root identity"'
    for name in catalog-list catalog-status catalog-pull catalog-evict healthcheck; do
        [ -r "/opt/usenet/scripts/$name" ] || exit 66
        /bin/sh -n "/opt/usenet/scripts/$name"
    done
    [ -r /opt/usenet/scripts/catalogctl.py ] || exit 66
    printf '%s\n' 'Non-root catalog entrypoint and mounted scripts ready'
    exit 0
fi
case "$tool" in
    catalog-list|catalog-status|catalog-pull|catalog-evict|healthcheck)
        ;;
    *)
        echo "catalog-run: unsupported QNAP command: $tool" >&2
        exit 64
        ;;
esac

if [ "$#" -gt 0 ]; then
    shift
fi

script="/opt/usenet/scripts/$tool"
if [ ! -r "$script" ]; then
    echo "catalog-run: repository script is not readable: $script" >&2
    exit 66
fi

# The repository wrappers need not be executable on the NAS bind mount.
exec /bin/sh "$script" "$@"
