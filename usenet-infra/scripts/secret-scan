#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

pattern='BEGIN (OPENSSH|RSA|EC|DSA) PRIVATE KEY|HCLOUD_TOKEN[[:space:]]*=[[:space:]]*[A-Za-z0-9_-]{20,}|(SABNZBD|PROWLARR)_API_KEY[[:space:]]*=[[:space:]]*[A-Za-z0-9_-]{20,}'
failed=0

if rg -l --hidden \
  --glob '!scripts/secret-scan' \
  --glob '!**/.env' \
  --glob '!**/secrets/**' \
  --glob '!**/.terraform/**' \
  --glob '!**/__pycache__/**' \
  "${pattern}" usenet-infra; then
  echo "Possible credential material found in project source files." >&2
  failed=1
fi

if ! git ls-files -z -- usenet-infra | python3 -c '
import pathlib, sys
forbidden = []
for raw in sys.stdin.buffer.read().split(b"\0"):
    if not raw:
        continue
    path = pathlib.PurePosixPath(raw.decode())
    name = path.name
    if ("secrets" in path.parts or ".secrets" in path.parts or "backups" in path.parts
            or name == ".env" or (name.startswith(".env.") and name != ".env.example")
            or name == "dashboard-auth.json"
            or ".tfstate" in name or name.endswith((".tfplan", ".tfvars"))
            or path.as_posix() == "usenet-infra/ansible/inventory.yml"
            or "/config/runtime/" in path.as_posix()):
        forbidden.append(str(path))
for path in forbidden:
    print(path)
raise SystemExit(bool(forbidden))
'; then
  echo "A runtime secret/state path is tracked despite ignore rules." >&2
  failed=1
fi

if git log --all -p -- usenet-infra \
  ':(exclude)usenet-infra/scripts/secret-scan' | grep -E "${pattern}" >/dev/null; then
  echo "Possible credential material found in Git history." >&2
  failed=1
fi

if ((failed)); then
  exit 1
fi
echo "No high-confidence credentials found in usenet-infra files or Git history."
