#!/usr/bin/env bash
set -euo pipefail

: "${CLOUD_SSH_TARGET:?Set CLOUD_SSH_TARGET in usenet-infra/.env}"
: "${CLOUD_SSH_KEY:?Set CLOUD_SSH_KEY to the dedicated cloud administrator key}"
: "${CLOUD_SSH_KNOWN_HOSTS:?Set CLOUD_SSH_KNOWN_HOSTS to the verified cloud host-key file}"

if (($# == 0)); then
  echo "usage: cloud-command <remote command> [arguments ...]" >&2
  exit 2
fi

printf -v arguments_q ' %q' "$@"
ssh_args=(-o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes
  -i "${CLOUD_SSH_KEY}" -o "UserKnownHostsFile=${CLOUD_SSH_KNOWN_HOSTS}")

exec ssh "${ssh_args[@]}" "${CLOUD_SSH_TARGET}" \
  "exec${arguments_q}"
