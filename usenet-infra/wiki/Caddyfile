{
	admin off
	auto_https off
	persist_config off
	log {
		output discard
	}
}

(static_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cache-Control "no-cache"
	}
}

:8080 {
	import static_headers
	handle /healthz {
		respond "ok" 200
	}
	root * /srv
	encode zstd gzip
	file_server
}

:8090 {
	import static_headers
	handle /healthz {
		respond "ok" 200
	}
	# Keep the original fragment and a DNS-independent destination.
	redir / http://192.168.1.66/media/usenet/ 302
	root * /srv
	file_server
}
