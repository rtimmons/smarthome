+	"github.com/stretchr/testify/require"
+)
+
+type corruptSameSize struct{ storage.Driver }
+
+func (d corruptSameSize) Write(ctx context.Context, p string, r io.Reader, n int64) error {
+	b, err := io.ReadAll(r)
+	if err != nil {
+		return err
+	}
+	if len(b) > 0 {
+		b[0] ^= 1
+	}
+	return d.Driver.(storage.Writer).Write(ctx, p, strings.NewReader(string(b)), n)
+}
+
+func TestSmarthomeSameSizeCorruptionPreservesSource(t *testing.T) {
+	f := newCrossFixture(t, func(d storage.Driver) storage.Driver { return corruptSameSize{d} })
+	writeA(t, f, "fixture.txt", "synthetic fixture")
+	op := f.run(t, ops.OpMove, []string{"fixture.txt"}, "/")
+	require.Equal(t, ops.StatusFailed, op.Status)
+	require.Contains(t, op.Error, "SHA-256 mismatch")
+	require.FileExists(t, filepath.Join(f.rootA, "fixture.txt"))
+}
+
+func TestSmarthomeVerifiedMoveHasReceiptAndRecoverableSource(t *testing.T) {
+	t.Setenv("FILEX_SAFE_TRANSFERS", "1")
+	receipts := t.TempDir()
+	t.Setenv("FILEX_TRANSFER_RECEIPTS", receipts)
+	f := newCrossFixture(t, nil)
+	writeA(t, f, "fixture.txt", "synthetic fixture")
+	op := f.run(t, ops.OpMove, []string{"fixture.txt"}, "/")
+	require.Equal(t, ops.StatusOK, op.Status, op.Error)
+	require.Equal(t, "synthetic fixture", readB(t, f, "fixture.txt"))
+	paths, err := filepath.Glob(filepath.Join(f.rootA, ".filex-trash", "*"))
+	require.NoError(t, err)
+	require.Len(t, paths, 1)
+	data, err := os.ReadFile(paths[0])
+	require.NoError(t, err)
+	require.Equal(t, "synthetic fixture", string(data))
+	records, err := os.ReadDir(receipts)
+	require.NoError(t, err)
+	require.Len(t, records, 2)
+	for _, entry := range records {
+		b, err := os.ReadFile(filepath.Join(receipts, entry.Name()))
+		require.NoError(t, err)
+		var receipt map[string]any
+		require.NoError(t, json.Unmarshal(b, &receipt))
+		files := receipt["files"].([]any)
+		require.Len(t, files, 1)
+		require.Len(t, files[0].(map[string]any)["sha256"], 64)
+	}
+}
+
+func TestSmarthomeReceiptFailurePreservesSource(t *testing.T) {
+	t.Setenv("FILEX_SAFE_TRANSFERS", "1")
+	t.Setenv("FILEX_TRANSFER_RECEIPTS", "")
+	f := newCrossFixture(t, nil)
+	writeA(t, f, "fixture.txt", "synthetic fixture")
+	op := f.run(t, ops.OpMove, []string{"fixture.txt"}, "/")
+	require.Equal(t, ops.StatusFailed, op.Status)
+	require.FileExists(t, filepath.Join(f.rootA, "fixture.txt"))
+}
+
+func TestSmarthomeReadOnlyQueueGuard(t *testing.T) {
+	t.Setenv("FILEX_SAFE_TRANSFERS", "1")
+	f := newCrossFixture(t, nil)
+	ctx := context.Background()
+	f.stA.ReadOnly = true
+	require.NoError(t, f.store.UpdateStorage(ctx, f.stA))
+	for _, kind := range []string{ops.OpMove, ops.OpDelete, ops.OpUploadCommit} {
+		_, err := f.svc.SubmitTo(ctx, kind, f.stA.ID, f.stB.ID, []string{"fixture.txt"}, "/")
+		require.Error(t, err)
+	}
+	_, err := f.svc.SubmitTo(ctx, ops.OpCopy, f.stA.ID, f.stB.ID, []string{"fixture.txt"}, "/")
+	require.NoError(t, err)
+	f.stB.ReadOnly = true
+	require.NoError(t, f.store.UpdateStorage(ctx, f.stB))
+	_, err = f.svc.SubmitTo(ctx, ops.OpCopy, f.stA.ID, f.stB.ID, []string{"fixture.txt"}, "/")
+	require.Error(t, err)
+}
+
+func TestSmarthomeReadOnlyChangeAfterSubmissionStopsWorker(t *testing.T) {
+	t.Setenv("FILEX_SAFE_TRANSFERS", "1")
+	t.Setenv("FILEX_TRANSFER_RECEIPTS", t.TempDir())
+	f := newCrossFixture(t, nil)
