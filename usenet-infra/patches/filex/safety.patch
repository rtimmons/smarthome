--- a/web/tests/operations/reconnect.test.ts
+++ b/web/tests/operations/reconnect.test.ts
@@ -0,0 +1,32 @@
+import { describe, it, expect, vi } from 'vitest';
+import { defineComponent } from 'vue';
+import { mount } from '@vue/test-utils';
+import { usePendingOps } from '../../../packages/core/src/composables/usePendingOps';
+
+describe('durable operation reconnect', () => {
+  it('shows prior failures until dismissed, and recent completion after a disconnected client', async () => {
+    const now = Date.now();
+    const rows = [
+      { id: 1, kind: 'copy', status: 'failed', error: 'Interrupted by restart', finished_at: new Date(now - 3600000).toISOString() },
+      { id: 2, kind: 'copy', status: 'ok', finished_at: new Date(now - 1000).toISOString() },
+      { id: 3, kind: 'copy', status: 'ok', finished_at: new Date(now - 3600000).toISOString() },
+    ];
+    let tracker: ReturnType<typeof usePendingOps>;
+    const settled = vi.fn();
+    const host = mount(defineComponent({ setup() {
+      tracker = usePendingOps({} as any, { endpoints: { opsList: '/ops' }, jsonFetch: async () => ({ ops: rows }) } as any, { onSettled: settled });
+      return () => null;
+    } }));
+    await tracker!.poll();
+    expect(tracker!.ops.value.map(o => o.id)).toEqual([1, 2]);
+    expect(tracker!.ops.value[0].error_message).toBe('Interrupted by restart');
+    expect(settled).not.toHaveBeenCalled();
+    const clock = vi.spyOn(Date, 'now').mockReturnValue(now + 60000);
+    await tracker!.poll();
+    expect(tracker!.ops.value.map(o => o.id)).toEqual([1]);
+    tracker!.dismiss(1);
+    await tracker!.poll();
+    expect(tracker!.ops.value).toEqual([]);
+    clock.mockRestore(); host.unmount();
+  });
+});
