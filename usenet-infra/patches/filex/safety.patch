+package ops
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"time"
+
+	"github.com/brf-tech/filex/backend/internal/storage"
+)
+
+// Check both when accepting a request and immediately before executing it.
+func (s *Service) guardWrite(ctx context.Context, kind string, source, destination int64) error {
+	if os.Getenv("FILEX_SAFE_TRANSFERS") != "1" {
+		return nil
+	}
+	if destination == 0 {
+		destination = source
+	}
+	ids := []int64{}
+	if kind != OpCopy {
+		ids = append(ids, source)
+	}
+	if kind == OpCopy || kind == OpMove {
+		ids = append(ids, destination)
+	}
+	for _, id := range ids {
+		var readonly, enabled bool
+		err := s.db.QueryRowContext(ctx, s.q(`SELECT read_only, enabled FROM storages WHERE id=?`), id).Scan(&readonly, &enabled)
+		if err != nil || readonly || !enabled {
+			return errors.New("storage is read-only, disabled or unavailable")
+		}
+	}
+	return nil
+}
+
+func hashFile(ctx context.Context, drv storage.Driver, name string) ([]byte, error) {
+	r, err := drv.Read(ctx, name)
+	if err != nil {
+		return nil, err
+	}
+	h := sha256.New()
+	_, err = io.Copy(h, r)
+	closeErr := r.Close()
+	if err != nil {
+		return nil, err
+	}
+	if closeErr != nil {
+		return nil, closeErr
+	}
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	return h.Sum(nil), nil
+}
+
+// Re-read the complete current source tree before quarantine. New children,
+// removed files, changed bytes and same-size corruption all fail closed.
+func verifyTree(ctx context.Context, a, b storage.Driver, src, dst string) error {
+	sa, err := a.Stat(ctx, src)
+	if err != nil {
+		return err
+	}
+	sb, err := b.Stat(ctx, dst)
+	if err != nil {
+		return err
+	}
+	if sa.Kind != sb.Kind {
+		return errors.New("verification: object kind changed")
+	}
+	if sa.Kind != storage.KindDirectory {
+		ha, err := hashFile(ctx, a, src)
+		if err != nil {
+			return err
+		}
+		hb, err := hashFile(ctx, b, dst)
+		if err != nil {
+			return err
+		}
+		if sa.Size != sb.Size || !bytes.Equal(ha, hb) {
+			return errors.New("verification: source changed or destination corrupted")
+		}
+		return nil
+	}
+	aa, err := a.List(ctx, src)
+	if err != nil {
+		return err
+	}
+	bb, err := b.List(ctx, dst)
+	if err != nil {
+		return err
+	}
+	names := map[string]bool{}
+	for _, o := range bb {
+		if !skipNames[o.Name] {
+			names[o.Name] = true
+		}
+	}
+	for _, o := range aa {
+		if skipNames[o.Name] {
+			return errors.New("move of bookkeeping directories is forbidden")
+		}
+		if !names[o.Name] {
+			return errors.New("verification: directory contents changed")
+		}
+		delete(names, o.Name)
+		if err := verifyTree(ctx, a, b, path.Join(src, o.Name), path.Join(dst, o.Name)); err != nil {
+			return err
+		}
+	}
+	if len(names) != 0 {
+		return errors.New("verification: directory contents changed")
+	}
+	return nil
+}
+
+// Receipts are private, append-only files. Failure to persist stops a move.
+// Actual names belong here, never in a committed operational receipt.
+func recordTransfer(op *Op, src, dst, phase string, files []map[string]any) error {
+	if os.Getenv("FILEX_SAFE_TRANSFERS") != "1" {
+		return nil
+	}
+	root := os.Getenv("FILEX_TRANSFER_RECEIPTS")
+	if !filepath.IsAbs(root) {
+		return errors.New("private transfer receipt directory required")
+	}
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return err
+	}
+	key := sha256.Sum256([]byte(fmt.Sprintf("%d:%s:%s:%s", op.ID, src, dst, phase)))
+	name := filepath.Join(root, hex.EncodeToString(key[:])+".json")
+	f, err := os.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	payload := map[string]any{"operation_id": op.ID, "source_storage": op.StorageID,
+		"destination_storage": op.DestStorageID, "source": src, "destination": dst,
+		"phase": phase, "files": files, "verification": "independent-destination-sha256", "at": time.Now().UTC()}
+	err = json.NewEncoder(f).Encode(payload)
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	dir, err := os.Open(root)
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	return dir.Sync()
+}
