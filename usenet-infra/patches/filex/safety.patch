+package local
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestSmarthomeTraversalAndSymlinkConfinement(t *testing.T) {
+	root, outside := t.TempDir(), t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(outside, "secret.txt"), []byte("private fixture"), 0600))
+	require.NoError(t, os.Symlink(outside, filepath.Join(root, "escape")))
+	d := &Driver{}
+	require.NoError(t, d.Init(context.Background(), map[string]any{"path": root}))
+	for _, p := range []string{"../secret.txt", "escape/secret.txt", "/escape/secret.txt"} {
+		_, err := d.Read(context.Background(), p)
+		require.Error(t, err)
+	}
+}
--- a/backend/internal/storage/drivers/sftp/sftp.go
