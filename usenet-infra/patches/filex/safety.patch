 	}
+	current := d.root
+	for _, part := range strings.Split(strings.TrimPrefix(abs, d.root), string(filepath.Separator)) {
+		current = filepath.Join(current, part)
+		info, err := os.Lstat(current)
+		if err != nil && !os.IsNotExist(err) {
+			return "", err
+		}
+		if err == nil && info.Mode()&os.ModeSymlink != 0 {
+			return "", errors.New("local: symlinks refused")
+		}
+	}
+
 	return abs, nil
