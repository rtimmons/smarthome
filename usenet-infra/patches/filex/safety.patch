@@ -370,9 +370,16 @@
 	if err != nil {
 		return err
 	}
-	defer f.Close()
-	_, err = io.Copy(f, r)
-	return err
+	// Bound in-flight writes to 16 packets (512 KiB). The transfer reader
+	// wraps hashing/progress and does not expose Size, so io.Copy otherwise
+	// falls back to one packet per round trip. Partial output stays on error;
+	// the operation is never successful until independent SHA-256 readback.
+	_, err = f.ReadFromWithConcurrency(r, 16)
+	closeErr := f.Close()
+	if err != nil {
+		return err
+	}
+	return closeErr
 }
 
