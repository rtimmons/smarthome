# Workstation-only connection settings used by this directory's Justfile.
# Copy to .env and do not commit host-specific values.

CLOUD_SSH_TARGET=usenet-admin@REPLACE_WITH_CLOUD_HOST
CLOUD_SSH_KEY=/absolute/path/to/cloud-admin
CLOUD_SSH_KNOWN_HOSTS=/absolute/path/to/cloud-known-hosts
CLOUD_PROJECT_DIR=/srv/usenet/compose/cloud

QNAP_SSH_TARGET=REPLACE_WITH_QNAP_USER@REPLACE_WITH_QNAP_LAN_HOST
QNAP_SSH_KEY=/absolute/path/to/qnap-admin-key
QNAP_SSH_KNOWN_HOSTS=/absolute/path/to/qnap-known-hosts
QNAP_PROJECT_DIR=/share/Container/usenet/compose/qnap
