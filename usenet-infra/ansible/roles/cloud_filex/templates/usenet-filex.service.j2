[Unit]
Description=Private file portal with verified transfers
Requires=docker.service usenet-library.service usenet-vpn-address.service
After=docker.service usenet-library.service usenet-vpn-address.service
BindsTo=usenet-library.service

[Service]
Type=simple
WorkingDirectory=/etc/usenet-filex
ExecStart=/usr/bin/docker compose up --no-build --pull never --abort-on-container-exit --exit-code-from filex
ExecStop=/usr/bin/docker compose stop --timeout 30
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
