[Unit]
Description=Admit one capacity-safe Usenet acquisition at a time
Requires=usenet-library.service usenet-discovery.service
BindsTo=usenet-library.service
After=network-online.target usenet-library.service usenet-discovery.service usenet-cart-import.service

[Service]
Type=oneshot
User=usenet
Group=usenet
EnvironmentFile={{ cloud_data_root }}/config/catalog.env
WorkingDirectory={{ cloud_data_root }}
ExecStartPre=/usr/bin/mountpoint -q {{ cloud_data_root }}/library
ExecStart=/usr/bin/python3 {{ cloud_data_root }}/libexec/capacity-admission.py run
UMask=0077
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ cloud_data_root }}/state/catalog {{ cloud_data_root }}/downloads/incomplete {{ cloud_data_root }}/downloads/complete
