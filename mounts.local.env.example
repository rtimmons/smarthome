# Copy to mounts.local.env and replace only the host/user placeholders.
# macOS asks for SMB credentials as needed and keeps them in Keychain; never put
# a password in these URLs. Separate multiple URLs with commas.

# Hetzner Storage Box read-only subaccount. Its SMB share name is the same as
# its username. SMB must be enabled for this account in Terraform and applied.
STORAGEBOX_SMB_VOLUMES="smb://u12345-sub1@u12345-sub1.your-storagebox.de/u12345-sub1"

# QNAP shares used by the Usenet deployment. Omit "your-qnap-user@" to let
# Finder prompt for it, or replace it with the SMB account you use on the NAS.
USENET_NAS_SMB_VOLUMES="smb://your-qnap-user@192.168.1.66/Usenet,smb://your-qnap-user@192.168.1.66/Container"
